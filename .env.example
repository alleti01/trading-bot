# =========================================================================
# Tradeify-style trading bot — example environment configuration.
# Copy to `.env` and edit. NEVER commit your real `.env`.
# =========================================================================

# ---- Mode --------------------------------------------------------------
# One of: BACKTEST | TRAIN | PAPER | LIVE
# LIVE is locked by default. See LIVE_ADAPTER_CONFIRMED below.
MODE=PAPER

# ---- Instrument & market ----------------------------------------------
INSTRUMENT=MES
MARKET_TYPE=futures        # futures | crypto
TIMEZONE=America/New_York

# ---- LIVE-mode lockout ------------------------------------------------
# DO NOT set to true unless a real broker/exchange adapter is implemented
# and you fully accept the risk of real-money trading.
LIVE_ADAPTER_CONFIRMED=false

# ---- Trading windows (HH:MM in TIMEZONE) ------------------------------
TRADING_WINDOW_START=09:30
TRADING_WINDOW_END=15:55
FORCE_FLAT_TIME=15:55

# ---- Risk -------------------------------------------------------------
MAX_TRADES_PER_DAY=8
MAX_DAILY_LOSS=500
MAX_DAILY_PROFIT=1500
MAX_POSITION_SIZE=1
RISK_PER_TRADE=100
MAX_OPEN_POSITIONS=1
COOLDOWN_AFTER_LOSS_MINUTES=5
COOLDOWN_AFTER_LARGE_WIN_MINUTES=15
LARGE_WIN_THRESHOLD=200
MAX_HOLD_BARS=20

# ---- Model ------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.60

# ---- Costs ------------------------------------------------------------
# Futures: tick-based slippage + flat per-contract commission.
SLIPPAGE_TICKS=1
COMMISSION_PER_CONTRACT=1.50
# Crypto: independent bps-based slippage + fee. Used when MARKET_TYPE=crypto.
CRYPTO_SLIPPAGE_BPS=1.0
CRYPTO_FEE_BPS=5.0

# ---- Compliance -------------------------------------------------------
# Largest winning day / total profit must stay below this percentage.
CONSISTENCY_LIMIT_PERCENT=30

# ---- LLM agents (advisory only, never trade) --------------------------
# Day 7: agents summarize, explain, and enrich reports. They cannot place
# trades, change risk limits, or modify the model. Set ENABLE_LLM_AGENTS=true
# AND provide OPENAI_API_KEY to actually call the LLM. Otherwise the bot
# runs unchanged and the orchestrator is a no-op.
ENABLE_LLM_AGENTS=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
AGENTS_RUN_AT_EOD=true
# Pre-session NewsAgent runs once per local day at this time (HH:MM in TIMEZONE).
NEWS_CHECK_LOCAL_TIME=09:25

# ---- Notifications ----------------------------------------------------
DISCORD_WEBHOOK_URL=

# ---- Paper service (Day 5) -------------------------------------------
BAR_INTERVAL_SECONDS=60
ROLLING_WINDOW_BARS=500
# Optional CSV path replayed by RollingCSVFeed when MODE=PAPER. If unset
# and you didn't pass --paper-csv, the service falls back to a synthetic
# feed for smoke runs only.
PAPER_CSV_PATH=
HEARTBEAT_LOCAL_TIME=08:00

# ---- Storage ----------------------------------------------------------
DATABASE_URL=sqlite:///./data/bot.db

# ---- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
