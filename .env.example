# =========================================================================
# Tradeify-style trading bot — example environment configuration.
# Copy to `.env` and edit. NEVER commit your real `.env`.
# =========================================================================

# ---- Mode --------------------------------------------------------------
# One of: BACKTEST | TRAIN | PAPER | LIVE
# LIVE is locked by default. See LIVE_ADAPTER_CONFIRMED below.
MODE=PAPER

# ---- Instrument & market ----------------------------------------------
INSTRUMENT=MES
MARKET_TYPE=futures        # futures | crypto
TIMEZONE=America/New_York

# ---- LIVE-mode lockout ------------------------------------------------
# DO NOT set to true unless a real broker/exchange adapter is implemented
# and you fully accept the risk of real-money trading.
LIVE_ADAPTER_CONFIRMED=false

# ---- Trading windows (HH:MM in TIMEZONE) ------------------------------
TRADING_WINDOW_START=09:30
TRADING_WINDOW_END=15:55
FORCE_FLAT_TIME=15:55

# ---- Risk -------------------------------------------------------------
MAX_TRADES_PER_DAY=8
MAX_DAILY_LOSS=500
MAX_DAILY_PROFIT=1500
MAX_POSITION_SIZE=1
RISK_PER_TRADE=100
MAX_OPEN_POSITIONS=1
COOLDOWN_AFTER_LOSS_MINUTES=5
COOLDOWN_AFTER_LARGE_WIN_MINUTES=15
LARGE_WIN_THRESHOLD=200
MAX_HOLD_BARS=20

# ---- Model ------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.60

# ---- Costs ------------------------------------------------------------
SLIPPAGE_TICKS=1
COMMISSION_PER_CONTRACT=1.50

# ---- Compliance -------------------------------------------------------
# Largest winning day / total profit must stay below this percentage.
CONSISTENCY_LIMIT_PERCENT=30

# ---- LLM agents (advisory only, never trade) --------------------------
ENABLE_LLM_AGENTS=false
OPENAI_API_KEY=

# ---- Notifications ----------------------------------------------------
DISCORD_WEBHOOK_URL=

# ---- Storage ----------------------------------------------------------
DATABASE_URL=sqlite:///./data/bot.db

# ---- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
