# =========================================================================
# Tradeify-style trading bot — example environment configuration.
# Copy to `.env` and edit. NEVER commit your real `.env`.
# =========================================================================

# ---- Mode --------------------------------------------------------------
# One of: BACKTEST | TRAIN | PAPER | LIVE
# LIVE is locked by default. See LIVE_ADAPTER_CONFIRMED below.
MODE=PAPER

# ---- Instrument & market ----------------------------------------------
INSTRUMENT=MES
MARKET_TYPE=futures        # futures | crypto
TIMEZONE=America/New_York

# ---- LIVE-mode lockout ------------------------------------------------
# DO NOT set to true unless a real broker/exchange adapter is implemented
# and you fully accept the risk of real-money trading.
LIVE_ADAPTER_CONFIRMED=false

# ---- Trading windows (HH:MM in TIMEZONE) ------------------------------
TRADING_WINDOW_START=09:30
TRADING_WINDOW_END=15:55
FORCE_FLAT_TIME=15:55

# ---- Risk -------------------------------------------------------------
MAX_TRADES_PER_DAY=8
MAX_DAILY_LOSS=500
MAX_DAILY_PROFIT=1500
MAX_POSITION_SIZE=1
RISK_PER_TRADE=100
MAX_OPEN_POSITIONS=1
COOLDOWN_AFTER_LOSS_MINUTES=5
COOLDOWN_AFTER_LARGE_WIN_MINUTES=15
LARGE_WIN_THRESHOLD=200
MAX_HOLD_BARS=20

# ---- Model ------------------------------------------------------------
CONFIDENCE_THRESHOLD=0.60

# ---- Costs ------------------------------------------------------------
# Futures: tick-based slippage + flat per-contract commission.
SLIPPAGE_TICKS=1
COMMISSION_PER_CONTRACT=1.50
# Crypto: independent bps-based slippage + fee. Used when MARKET_TYPE=crypto.
CRYPTO_SLIPPAGE_BPS=1.0
CRYPTO_FEE_BPS=5.0

# ---- Compliance -------------------------------------------------------
# Largest winning day / total profit must stay below this percentage.
CONSISTENCY_LIMIT_PERCENT=30

# ---- LLM agents (advisory only, never trade) --------------------------
# Agents summarize, explain, research, and enrich reports. They CANNOT
# place trades, change risk limits, modify the model, or auto-promote
# anything. Set ENABLE_LLM_AGENTS=true AND at least one provider API
# key to actually call an LLM — otherwise the orchestrator is a no-op.
ENABLE_LLM_AGENTS=false
LLM_TIMEOUT_SECONDS=30
AGENTS_RUN_AT_EOD=true
# Pre-session NewsAgent runs once per local day at this time (HH:MM in TIMEZONE).
NEWS_CHECK_LOCAL_TIME=09:25
# Legacy single-model knob — kept for back-compat. Prefer
# ``OPENAI_DEFAULT_MODEL`` below. When both are set ``OPENAI_MODEL``
# wins so existing deployments keep working.
LLM_MODEL=gpt-4o-mini

# =========================
# LLM / RESEARCH API KEYS
# =========================

# Used by OpenAI-powered agents:
# TradeAnalysisAgent, ModelReviewAgent, ReportAgent,
# RiskExplainerAgent, TradeJournalAgent, BacktestCriticAgent.
OPENAI_API_KEY=

# Used by Perplexity-powered agents:
# NewsAgent, MacroNewsAgent, StrategyResearchAgent.
PERPLEXITY_API_KEY=

# Optional future providers. Not required right now.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# =========================
# AGENT PROVIDER ROUTING
# =========================

# Web/current research agents.
NEWS_AGENT_PROVIDER=perplexity
MACRO_NEWS_AGENT_PROVIDER=perplexity
STRATEGY_RESEARCH_AGENT_PROVIDER=perplexity

# Structured reasoning / reporting agents.
TRADE_ANALYSIS_AGENT_PROVIDER=openai
MODEL_REVIEW_AGENT_PROVIDER=openai
REPORT_AGENT_PROVIDER=openai
RISK_EXPLAINER_AGENT_PROVIDER=openai
TRADE_JOURNAL_AGENT_PROVIDER=openai
BACKTEST_CRITIC_AGENT_PROVIDER=openai

# Stats-only by default. Set to "openai" only if you want optional narrative polish.
MODEL_DRIFT_AGENT_PROVIDER=none

# Data quality should stay deterministic/code-based by default.
DATA_QUALITY_AGENT_PROVIDER=none


# =========================
# PERPLEXITY MODELS
# =========================

# Default Perplexity model for current market/news research.
PERPLEXITY_DEFAULT_MODEL=sonar-pro

# Fast/current research.
NEWS_AGENT_MODEL=sonar-pro
MACRO_NEWS_AGENT_MODEL=sonar-pro

# Heavier research. Use sparingly, such as weekly strategy research.
STRATEGY_RESEARCH_AGENT_MODEL=sonar-deep-research


# =========================
# OPENAI MODELS
# =========================

# OpenAI default for normal structured outputs.
# Keep this configurable because available model names may change.
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Stronger model for harder reviews/audits.
OPENAI_REVIEW_MODEL=gpt-4o

# Per-agent OpenAI model mapping. The ``${VAR}`` shorthand below is
# *documentation only* — pydantic-settings does not expand env vars.
# Leave a per-agent value empty / "none" / "${OPENAI_DEFAULT_MODEL}"
# to inherit the right default; set a concrete model name to override.
TRADE_ANALYSIS_AGENT_MODEL=${OPENAI_DEFAULT_MODEL}
TRADE_JOURNAL_AGENT_MODEL=${OPENAI_DEFAULT_MODEL}
REPORT_AGENT_MODEL=${OPENAI_DEFAULT_MODEL}
RISK_EXPLAINER_AGENT_MODEL=${OPENAI_DEFAULT_MODEL}

MODEL_REVIEW_AGENT_MODEL=${OPENAI_REVIEW_MODEL}
BACKTEST_CRITIC_AGENT_MODEL=${OPENAI_REVIEW_MODEL}

# Model drift should mostly be deterministic stats.
# Set MODEL_DRIFT_AGENT_PROVIDER=openai and this to an OpenAI model
# only if narrative summaries are needed.
MODEL_DRIFT_AGENT_MODEL=none

# DataQualityAgent should not use an LLM by default.
DATA_QUALITY_AGENT_MODEL=none

# ---- Broker adapter (paper/demo only) ----------------------------------
# Allowed values:
#   mock      → in-memory simulator, never touches the network
#   alpaca    → Alpaca PAPER sandbox (current automation broker)
#   tradovate → Tradovate DEMO (futures, requires demo API access)
# Live trading is permanently locked at the workflow runner regardless
# of provider.
BROKER_PROVIDER=mock
DEFAULT_ORDER_TYPE=limit
BROKER_REQUEST_TIMEOUT_SECONDS=15
WORKFLOW_EXECUTION_MODE=DRY_RUN
AUTONOMOUS_TRADING_ENABLED=false
AUTONOMOUS_PAPER_ONLY=true

# ---- Alpaca (PAPER sandbox — equities, NOT futures) --------------------
# The adapter refuses to construct unless ALPACA_PAPER=true AND the
# base URL points at paper-api.alpaca.markets. Futures symbols
# (MES, MNQ, ES, NQ, MGC, MCL, MYM, M2K) are rejected at every order
# method. Use 'mock' or 'tradovate' for those.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- Tradovate (DEMO / SIMULATION ONLY) --------------------------------
# Currently future-use: requires demo API credentials, which Tradovate
# only issues to funded accounts. Kept here so the futures path is
# ready when credentials are available.
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0.0
TRADOVATE_CLIENT_ID=
TRADOVATE_CLIENT_SECRET=
TRADOVATE_DEMO=true
TRADOVATE_BASE_URL=https://demo.tradovateapi.com/v1
TRADOVATE_WS_URL=wss://demo.tradovateapi.com/v1/websocket

# ---- Autonomous workflows (paper-first orchestration) ------------------
# Separate from MODE. LIVE is always refused by the workflow runner.
WORKFLOW_EXECUTION_MODE=DRY_RUN
WORKFLOW_TIMEZONE=America/New_York
WORKFLOW_WEEKDAYS_ONLY=true
WORKFLOW_GIT_COMMIT=false
WORKFLOW_GIT_PUSH=false
PERPLEXITY_ENABLED=false
AUTONOMOUS_TRADING_ENABLED=false
AUTONOMOUS_PAPER_ONLY=true
WORKFLOW_MEMORY_DIR=./memory
# Optional model that gates workflow entries (scores each strategy setup).
# Leave empty for strategy-only mode (trade raw VWAP/EMA signals).
WORKFLOW_MODEL_NAME=
WORKFLOW_MODEL_VERSION=latest

# ---- Equity position sizing --------------------------------------------
# Size by risk: shares = RISK_PER_TRADE / per-share stop distance, capped
# by share count and notional dollars (so a $50 and a $900 stock risk the
# same and never exceed buying power). false = fixed MAX_POSITION_SIZE.
USE_RISK_BASED_SIZING=true
MAX_SHARES_PER_TRADE=100
MAX_NOTIONAL_PER_TRADE=10000

# ---- Strategy time-of-day filter ---------------------------------------
# Skip VWAP/EMA setups within N minutes of the RTH open/close (noisiest
# periods). 0 = no filter.
STRATEGY_SKIP_OPEN_MINUTES=0
STRATEGY_SKIP_CLOSE_MINUTES=0

# ---- Minimum stop distance (anti-whipsaw) ------------------------------
# Floor the stop at max(MIN_STOP_DISTANCE_PCT * price, MIN_STOP_DISTANCE_CENTS)
# so calm names don't get sub-spread stops that whipsaw out instantly.
# The target widens to keep R:R; sizing trims shares to hold dollar risk.
MIN_STOP_DISTANCE_PCT=0.0015
MIN_STOP_DISTANCE_CENTS=0.05

# ---- Continuous intraday loop + dynamic universe -----------------------
# The intraday scanner (--workflow-intraday) re-scans every N minutes
# during the trading window and places bracket orders on approved setups.
WORKFLOW_SCAN_INTERVAL_MINUTES=5
WORKFLOW_REFRESH_DATA_EACH_SCAN=true
WORKFLOW_LONG_ONLY=true
# Stop opening NEW positions within N minutes of the close, so a fresh
# entry isn't force-flatted moments later (open-then-flatten churn).
WORKFLOW_NO_ENTRY_MINUTES_BEFORE_CLOSE=20
# Dynamic universe expands the scan set beyond ENABLED_SYMBOLS using the
# vetted liquid allowlist (config/equity_allowlist.py). Research agents
# may only rank allowlist names — never invent tickers, never trade.
WORKFLOW_DYNAMIC_UNIVERSE=false
WORKFLOW_MAX_UNIVERSE=15
WORKFLOW_AGENT_WATCHLIST=false

# ---- Options trading (paper / simulation only) -------------------------
# Trades calls/puts/spreads/condors on top of the VWAP/EMA signal on the
# underlying. Execution is Alpaca paper or mock only — never live.
OPTIONS_ENABLED=false
# atm_directional | vertical_spread | iron_condor
OPTIONS_STRATEGY=atm_directional
OPTIONS_ENABLED_UNDERLYINGS=SPY,QQQ,AAPL,MSFT
OPTIONS_DEFAULT_DTE=30
OPTIONS_MIN_DTE=7
OPTIONS_MAX_DTE=60
OPTIONS_TARGET_DELTA=0.50
OPTIONS_SPREAD_WIDTH_STRIKES=1
OPTIONS_MAX_PREMIUM_PER_TRADE=500
OPTIONS_MAX_OPEN_POSITIONS=5
OPTIONS_AUTO_CLOSE_DTE=5
OPTIONS_AUTO_ROLL=true
OPTIONS_ROLL_DTE_TRIGGER=7
OPTIONS_PROFIT_TARGET_PCT=50
OPTIONS_STOP_LOSS_PCT=-50
OPTIONS_QTY_PER_TRADE=1
OPTIONS_STATE_PATH=data/options/positions.json

# ---- Parallel paper evaluation -----------------------------------------
# Run Alpaca (equities API plumbing) and futures_sim (local simulation)
# as independent evaluation tracks. They share nothing: no positions,
# no state files, no trade IDs.
ENABLE_PARALLEL_PAPER=false
PARALLEL_BROKERS=futures_sim,alpaca
ALPACA_ENABLED_SYMBOLS=SPY,QQQ,AAPL,MSFT
FUTURES_SIM_ENABLED_SYMBOLS=MES,MNQ,MGC,MCL
ALPACA_EVALUATION_ID=alpaca_2week_test
FUTURES_SIM_EVALUATION_ID=futures_sim_2week_test
ALPACA_STATE_PATH=data/paper/alpaca_state.json
FUTURES_SIM_STATE_PATH=data/paper/futures_sim_state.json

# ---- Notifications ----------------------------------------------------
DISCORD_WEBHOOK_URL=

# ---- Paper service (Day 5) -------------------------------------------
BAR_INTERVAL_SECONDS=60
ROLLING_WINDOW_BARS=500
# Optional CSV path replayed by RollingCSVFeed when MODE=PAPER. If unset
# and you didn't pass --paper-csv, the service falls back to a synthetic
# feed for smoke runs only.
PAPER_CSV_PATH=
HEARTBEAT_LOCAL_TIME=08:00

# ---- Storage ----------------------------------------------------------
DATABASE_URL=sqlite:///./data/bot.db

# ---- Logging ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false
